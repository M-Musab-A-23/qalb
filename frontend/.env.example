# URL of the ML analysis service. The /api/analyze route forwards uploads here.
ML_API_URL=http://localhost:8000

# Where the live monitor gets its data (read by the browser, so it is inlined at build time).
#   auto    replay from the ML service, simulated feed if it is not running (default)
#   replay  replay only; show an unavailable state if the service is down
#   mock    always the simulated feed
NEXT_PUBLIC_LIVE_FEED=auto
